# Copia este archivo como .env (o pon estas variables en cPanel › Setup Node.js App) y rellénalo.
# El archivo .env NUNCA va al repositorio.

# Dirección pública del backend, sin barra final
URL_PUBLICA=https://api.semillasdata.com
# Páginas que pueden usar el backend (separadas por comas)
ORIGENES=https://semillasdata.com,https://zandynicasiop-debug.github.io,https://appassets.androidplatform.net

# Base de datos (cPanel › Bases de datos MySQL)
MYSQL_HOST=localhost
MYSQL_PUERTO=3306
MYSQL_USUARIO=
MYSQL_CLAVE=
MYSQL_BASE=

# Google Cloud › APIs y servicios › Credenciales › ID de cliente OAuth (Aplicación web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pueden entrar todas las cuentas de este dominio de Workspace...
DOMINIO=
# ...y estos correos (separados por comas), que además gestionan el equipo
ADMINS=

# Clave para cifrar los tokens de Google en la base: genera una con  npm run clave
CLAVE_CIFRADO=
DIAS_SESION=30
ZONA_HORARIA=America/Santo_Domingo
MINUTOS_REUNION=30

# Opcional: webhook del espacio de Google Chat del equipo
CHAT_WEBHOOK=

# Opcional: avisos push en el teléfono y el ordenador con la app cerrada. Genera las claves con  npm run vapid
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTACTO=mailto:soporte@semillasdata.com

# Opcional: reportes PDF. Id de la plantilla de Google Docs (con {{campos}}) y de la carpeta de Drive
REPORTE_PLANTILLA_ID=
REPORTE_CARPETA_ID=

# Opcional: WhatsApp Business (developers.facebook.com › tu app › WhatsApp › Configuración de la API)
WHATSAPP_TOKEN=
WHATSAPP_TELEFONO_ID=
# Plantilla aprobada por Meta con una variable {{1}} para el texto del aviso
WHATSAPP_PLANTILLA=
WHATSAPP_IDIOMA=es
# Opcional: plantilla aprobada para avisar a un CLIENTE de que le llegó un correo o una invitación ({{1}})
WHATSAPP_PLANTILLA_CLIENTES=
