{
  "name": "semences-crm-servidor",
  "version": "2.1.0",
  "private": true,
  "description": "Backend de Semences del Caribe: base de datos del CRM (MySQL), inicio de sesión con Google Workspace, Gmail, Calendar, Meet, reportes PDF desde Docs y avisos por Google Chat y WhatsApp.",
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node app.js",
    "test": "node --test --test-concurrency=1 pruebas/*.test.js",
    "equipo": "node herramientas/equipo.js",
    "clave": "node herramientas/clave.js",
    "rotar-clave": "node herramientas/rotar-clave.js",
    "vapid": "node herramientas/vapid.js",
    "verificar": "node herramientas/verificar.js",
    "comprobar-respaldo": "node herramientas/comprobar-respaldo.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@googleapis/calendar": "^20.1.0",
    "@googleapis/docs": "^14.1.1",
    "@googleapis/drive": "^27.0.0",
    "@googleapis/gmail": "^22.0.2",
    "@googleapis/sheets": "^18.1.2",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "web-push": "^3.6.7"
  }
}
