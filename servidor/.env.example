# =====================================================================================================
#  Backend de Semences del Caribe · variables de entorno
#
#  Copia este archivo como .env (junto a app.js) o pon estas variables en cPanel › Setup Node.js App ›
#  Environment variables. El archivo .env NUNCA va al repositorio (está en .gitignore).
#
#  Al arrancar, el servidor comprueba el formato de cada una (src/config.js › validarEntorno):
#    - [OBLIGATORIA] o un formato peligroso (ORIGENES, ADMINS, DOMINIO, ZONA_HORARIA): no arranca y dice qué falta.
#    - Un número o un si/no mal escrito: arranca con el valor por defecto y lo avisa en el registro.
#  Las opcionales vacías apagan su función (Chat, WhatsApp, push, reportes, respaldos…).
# =====================================================================================================

# ----- Servidor ---------------------------------------------------------------------------------------
# [OBLIGATORIA] Dirección pública del backend, con https y sin barra final
URL_PUBLICA=https://api.semillasdata.com
# Páginas y apps que pueden usar el backend (origen: esquema://servidor, sin barra final), separadas por comas.
# Vacía = la web (semillasdata.com y app.semillasdata.com), GitHub Pages, la app Android propia,
# Capacitor (https://localhost y capacitor://localhost) y la app de escritorio (app://semences)
ORIGENES=
# Dirección de la app para el botón "Abrir la app" de los avisos (por defecto, el primer origen)
URL_APP=

# ----- Base de datos (cPanel › Bases de datos MySQL) --------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PUERTO=3306
# [OBLIGATORIA] usuario y base; la contraseña, larga y solo aquí
MYSQL_USUARIO=
MYSQL_CLAVE=
MYSQL_BASE=

# ----- Google: inicio de sesión (Google Cloud › APIs y servicios › Credenciales) ----------------------
# [OBLIGATORIA] ID de cliente OAuth de tipo "Aplicación web" y su secreto
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Dominio de Google Workspace de la empresa (sin @). Sus cuentas son la opción recomendada para entrar
DOMINIO=
# Correos (separados por comas) de los Master: entran siempre, con todo, y aprueban a los demás.
# [OBLIGATORIA] DOMINIO o ADMINS
ADMINS=
# Opción B: también cuentas personales de Google (Gmail…). Entran a la sala de espera y un Master decide.
# si (por defecto) o no. Con "si", la pantalla de consentimiento de OAuth tiene que ser "Externa"
CUENTAS_PERSONALES=si

# ----- Seguridad --------------------------------------------------------------------------------------
# [OBLIGATORIA] 64 caracteres hexadecimales: cifra los tokens de Google en la base. Genera una con  npm run clave
# (si se cambia, cada persona tiene que volver a conectar Google)
CLAVE_CIFRADO=
# Solo mientras se cambia la clave: la CLAVE_CIFRADO de antes. Pasos: npm run clave (nueva) › aquí la anterior y
# en CLAVE_CIFRADO la nueva › reinicia › npm run rotar-clave › quita esta variable. Nadie tiene que volver a entrar
CLAVE_CIFRADO_ANTERIOR=
# Días que dura una sesión sin usarse (1-365)
DIAS_SESION=30
# Límites por minuto: entradas con Google por IP, peticiones a la API por IP y acciones por persona
ENTRADAS_POR_MINUTO=20
PETICIONES_POR_MINUTO=600
ACCIONES_POR_MINUTO=240

# ----- Zona horaria y agenda --------------------------------------------------------------------------
# Zona IANA: America/Santo_Domingo (RD) o America/Caracas (Venezuela): las dos son UTC-4 todo el año
ZONA_HORARIA=America/Santo_Domingo
# Duración por defecto de reuniones e inspecciones (minutos)
MINUTOS_REUNION=30
# Resumen de la mañana ("Borja"): hora local 0-23, o "no" para no enviarlo
RESUMEN_HORA=7
# Reporte semanal de actividades: "no" para no pedirlo. Con él, desde el lunes la app solo deja entregar el
# reporte a quien no entregó el de la semana pasada (los Master nunca). Recordatorio el viernes a REPORTE_HORA (0-23)
REPORTE_SEMANAL=si
REPORTE_HORA=16
# Opcional: revisión de los reportes semanales con Claude (console.anthropic.com › API keys). Sin clave, apagada.
# Los reportes (actividades y comentarios de los empleados) se envían a Anthropic para resumirlos.
ANTHROPIC_API_KEY=
IA_MODELO=claude-opus-5-5
# Lunes a esta hora (0-23): resumen de la semana del equipo para los Master (con ANTHROPIC_API_KEY)
REPORTE_RESUMEN_HORA=8
# Germinador: por debajo de este % de germinación se avisa al equipo técnico del lote (1-100)
UMBRAL_GERMINACION=85

# ----- Google Workspace automático (sin nadie delante) -------------------------------------------------
# Correo de la cuenta del sistema: una persona del equipo (mejor un Master) que entró en la app y conectó
# Google. Con su permiso se hacen los respaldos en Drive y se envían los correos de aviso. Vacía: apagado
CUENTA_GOOGLE_SISTEMA=
# Respaldo diario de todo el CRM (archivo JSON) en esta carpeta de Drive (id: lo que va tras /folders/)
RESPALDO_CARPETA_ID=
# Hora local del respaldo (0-23) y cuántos días se conservan los respaldos
RESPALDO_HORA=2
RESPALDO_CONSERVAR=30
# Carpeta de Drive para los documentos de los clientes (una subcarpeta por cliente). Vacía: la de reportes
DOCUMENTOS_CARPETA_ID=
# Correos de aviso desde la cuenta del sistema (solicitudes de acceso, accesos aprobados…): si o no
CORREOS_AVISOS=si
# Cada mañana, los seguimientos, reuniones y tareas de cada persona pasan a su Google Calendar: si o no
AGENDA_AUTOMATICA=si

# ----- Bandeja de Instagram de administración (opcional; ver LEEME.md) --------------------------------
# Las cuentas de Instagram y sus tokens se dan de alta desde la app (Master). Aquí, el secreto de la app de Meta
# (firma de los avisos del webhook) y la palabra para verificar el webhook
META_APP_SECRET=
META_VERIFY_TOKEN=
META_VERSION=v21.0

# ----- Envíos de semilla con DHL y FedEx: rastreo automático (opcional) ---------------------------------
# DHL: developer.dhl.com › Shipment Tracking - Unified (clave de API)
DHL_API_KEY=
# FedEx: developer.fedex.com › proyecto con Track API (credenciales de producción; van juntas)
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_URL=https://apis.fedex.com
# Cada cuántos minutos se consulta cada guía activa (mínimo 15)
RASTREO_MINUTOS=60

# ----- Reportes PDF (plantilla de Google Docs con {{campos}}) -------------------------------------------
REPORTE_PLANTILLA_ID=
REPORTE_CARPETA_ID=

# ----- Google Chat (opcional) --------------------------------------------------------------------------
# Webhook del espacio del equipo (Configuración del espacio › Apps e integraciones › Webhooks)
CHAT_WEBHOOK=
# Avisos como tarjetas con botones (Unirse a Meet, Abrir la app): si (por defecto) o no
CHAT_TARJETAS=si

# ----- Avisos push (opcional, gratis) -------------------------------------------------------------------
# Genera las dos con  npm run vapid  (van juntas). Si se cambian, cada persona reactiva los avisos
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CONTACTO=mailto:soporte@semillasdata.com

# ----- WhatsApp Business (opcional; developers.facebook.com › tu app › WhatsApp) ----------------------
# Las tres primeras van juntas. La plantilla, aprobada por Meta, con una variable {{1}} para el texto
WHATSAPP_TOKEN=
WHATSAPP_TELEFONO_ID=
WHATSAPP_PLANTILLA=
WHATSAPP_IDIOMA=es
WHATSAPP_VERSION=v21.0
# Opcional: plantilla para avisar a un CLIENTE de que le llegó un correo o una invitación ({{1}})
WHATSAPP_PLANTILLA_CLIENTES=
# Opcional: plantilla del resumen de la mañana en varias líneas, con 7 variables (ver LEEME.md)
WHATSAPP_PLANTILLA_RESUMEN=
# Recomendado: bienvenida de Borja al entrar al equipo, con {{1}} = nombre y el botón «✅ Recibido» (ver LEEME.md)
WHATSAPP_PLANTILLA_BIENVENIDA=
